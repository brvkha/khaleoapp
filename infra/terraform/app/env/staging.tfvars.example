aws_region                    = "ap-southeast-1"
project                       = "khaleoapp"
environment                   = "staging"
vpc_cidr                      = "10.0.0.0/16"
public_subnet_cidr            = "10.0.1.0/24"
private_subnet_a_cidr         = "10.0.2.0/24"
private_subnet_b_cidr         = "10.0.3.0/24"
route53_zone_name             = "khaleoshop.click"
frontend_domain_name          = "staging.khaleoshop.click"
api_domain_name               = "api-staging.khaleoshop.click"
ec2_instance_type             = "t3.micro"
db_instance_class             = "db.t3.micro"
db_name                       = "khaleoapp"
db_username                   = "app_user"
db_password                   = "REPLACE_ME_STRONG_PASSWORD"
db_backup_retention_days      = 7
allowed_http_cidrs            = ["0.0.0.0/0"]
enable_frontend_custom_domain = true

